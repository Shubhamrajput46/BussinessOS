# Copy to .env and edit.  Never commit the real .env file.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Kolkata

# --- Database (leave DB_HOST empty to use local SQLite) ---
DB_HOST=
DB_PORT=3306
DB_NAME=businessos
DB_USER=businessos
DB_PASSWORD=change-me
# used by docker-compose for the MySQL root account
DB_ROOT_PASSWORD=change-me-too

# --- API / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Production (DEBUG=False) behind HTTPS ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Container ---
WEB_PORT=8000
GUNICORN_WORKERS=3
RUN_MIGRATIONS=1

# --- Email (forgot-password links). Leave EMAIL_HOST empty to print emails in the console ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BusinessOS <no-reply@yourdomain.com>
PASSWORD_RESET_TIMEOUT=3600

# --- External MySQL over SSL (Aiven / TiDB / Clever Cloud ...). Leave empty for local/Docker MySQL ---
# Linux (Render): /etc/ssl/certs/ca-certificates.crt   |  or the path of the provider's ca.pem
DB_SSL_CA=
